---
/**
 * ExperiencePreview — Figma node 52:2.
 * 2×2 grid showcasing the 4 ExperienceCard variants on an inset surface.
 * Used by /components/experience as the Preview tab content.
 */
import ExperienceCard from '@/components/cv/ExperienceCard.tsx';
import '@/components/cv/ExperienceCard.css';
import '@/components/primitives/Badge.css';
import type { Experience } from '@/data/experiences';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<div class="experience-preview" aria-label="Preview des variants ExperienceCard">
  <div class="experience-preview-row">
    <ExperienceCard experience={experience} variant="default" />
    <ExperienceCard experience={experience} variant="expanded" />
  </div>
  <div class="experience-preview-row">
    <ExperienceCard experience={experience} variant="compact" />
    <ExperienceCard experience={experience} variant="timeline" />
  </div>
</div>

<style>
  .experience-preview {
    background: var(--bg-inset);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .experience-preview-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: flex-start;
  }
</style>
