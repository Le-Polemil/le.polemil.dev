---
import CodeBlock from '@/components/primitives/CodeBlock.astro';
import ComponentDocHeader from '@/components/system/ComponentDocHeader.astro';
import { EXPERIENCE_CARD_CODE_SAMPLE } from '@/data/experience-card-meta';
import DocLayout from '@/layouts/DocLayout.astro';
---

<DocLayout title="<Experience /> · Code — polemil.dev" page="experience">
  <article class="component-doc">
    <ComponentDocHeader
      title="<Experience />"
      subtitle="Une expérience pro. 4 variants, 3 états."
      basePath="/components/experience"
      active="code"
    />
    <section class="component-doc-content" aria-label="Code">
      <CodeBlock lang="tsx">{EXPERIENCE_CARD_CODE_SAMPLE}</CodeBlock>
    </section>
  </article>
</DocLayout>

<style>
  .component-doc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .component-doc-content {
    inline-size: 100%;
  }
</style>
