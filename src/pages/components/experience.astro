---
import ComponentDocHeader from '@/components/system/ComponentDocHeader.astro';
import { EXPERIENCES } from '@/data/experiences';
import DocLayout from '@/layouts/DocLayout.astro';
import ExperiencePreview from '@/patterns/ExperiencePreview.astro';

const experience = EXPERIENCES[0];
if (!experience) {
  throw new Error('experiences dataset is empty — at least one entry is required');
}
---

<DocLayout title="<Experience /> — polemil.dev" page="experience">
  <article class="component-doc">
    <ComponentDocHeader
      title="<Experience />"
      subtitle="Une expérience pro. 4 variants, 3 états."
      basePath="/components/experience"
      active="preview"
    />
    <section class="component-doc-content" aria-label="Preview">
      <ExperiencePreview experience={experience} selectable />
    </section>
  </article>
</DocLayout>

<style>
  .component-doc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .component-doc-content {
    inline-size: 100%;
  }
</style>
